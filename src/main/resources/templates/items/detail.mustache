<h1>물건 상세</h1>
<h2>{{item.name}}</h2>
<p>{{item.description}}</p>
<p>{{item.rentalStatus}}</p>

<a href="/items/{{item.id}}/edit">수정</a>

<form action="/items/{{item.id}}/delete" method="post">
    <button type="submit">삭제</button>
</form>

{{#item.available}}
<form action="/items/{{item.id}}/rent" method="post">
    <button type="submit">대여</button>
</form>
{{/item.available}}

{{#item.rented}}
<form action="/items/{{item.id}}/return" method="post">
    <button type="submit">반납</button>
</form>
{{/item.rented}}