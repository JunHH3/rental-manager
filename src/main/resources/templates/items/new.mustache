<h1>상품 등록</h1>
<form action="/items" method="post">
    <label>
        상품명
        <input type="text" name="name">
    </label>
    <label>
        설명
        <textarea name="description"></textarea>
    </label>
    <button type="submit">버튼</button>
</form>

{{#error}}
    <p>{{error}}</p>
{{/error}}